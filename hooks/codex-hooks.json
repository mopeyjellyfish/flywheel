{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/flywheel-hook-policy.js\" pre-tool codex",
            "statusMessage": "Checking Flywheel policy"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "Bash|apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/flywheel-hook-policy.js\" permission-request codex",
            "statusMessage": "Checking Flywheel approval request"
          }
        ]
      }
    ]
  }
}
